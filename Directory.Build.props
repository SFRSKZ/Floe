<Project>

  <PropertyGroup>
    <!-- Two products from one codebase: -p:FloeProduct=CP77 builds the Cyberpunk dock. -->
    <DefineConstants Condition="'$(FloeProduct)' == 'CP77'">$(DefineConstants);CP77</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <!-- the published binaries must not carry the build machine's folders -->
    <PathMap>$(MSBuildThisFileDirectory)=/floe/</PathMap>
  </PropertyGroup>
</Project>
