<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Floe</AssemblyName>
    <AssemblyName Condition="'$(FloeProduct)' == 'CP77'">FloeCP77</AssemblyName>
    <!-- the Cyberpunk dock wears its own icon; the plain build stays icon-less like before -->
    <ApplicationIcon Condition="'$(FloeProduct)' == 'CP77'">Assets\cp77.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Floe.Core\Floe.Core.csproj" />
    <EmbeddedResource Include="Effects\MetalRim\MetalRim.hlsl" LogicalName="Floe.MetalRim.hlsl" />
    <EmbeddedResource Include="Effects\ActiveIcon\ActiveIcon.hlsl" LogicalName="Floe.ActiveIcon.hlsl" />
    <EmbeddedResource Include="Effects\ActiveIcon\ClickGlass.hlsl" LogicalName="Floe.ClickGlass.hlsl" />
    <EmbeddedResource Include="Effects\ActiveIcon\ClickPaint.hlsl" LogicalName="Floe.ClickPaint.hlsl" />
    <EmbeddedResource Include="Effects\Chromatic\Chromatic.hlsl" LogicalName="Floe.Chromatic.hlsl" />
    <EmbeddedResource Include="Effects\Glass\DropLens.hlsl" LogicalName="Floe.DropLens.hlsl" />
    <EmbeddedResource Include="Effects\Glass\DozeGhost.hlsl" LogicalName="Floe.DozeGhost.hlsl" />
    <EmbeddedResource Include="Effects\Glass\LiquidGlass.hlsl" LogicalName="Floe.LiquidGlass.hlsl" />
    <EmbeddedResource Include="Effects\Visualizer\LedScreen.hlsl" LogicalName="Floe.LedScreen.hlsl" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
  </ItemGroup>

</Project>
