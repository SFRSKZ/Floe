<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Floe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Floe.Core\Floe.Core.csproj" />
    <ProjectReference Include="..\Floe.Plugins\Floe.Plugins.csproj" />
    <EmbeddedResource Include="Effects\MetalRim\MetalRim.hlsl" LogicalName="Floe.MetalRim.hlsl" />
    <EmbeddedResource Include="Effects\ActiveIcon\ActiveIcon.hlsl" LogicalName="Floe.ActiveIcon.hlsl" />
    <EmbeddedResource Include="Effects\ActiveIcon\ClickGlass.hlsl" LogicalName="Floe.ClickGlass.hlsl" />
    <EmbeddedResource Include="Effects\Chromatic\Chromatic.hlsl" LogicalName="Floe.Chromatic.hlsl" />
    <EmbeddedResource Include="Effects\Glass\DropLens.hlsl" LogicalName="Floe.DropLens.hlsl" />
    <EmbeddedResource Include="Effects\Glass\DozeGhost.hlsl" LogicalName="Floe.DozeGhost.hlsl" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\plugins\**\*.*" Link="plugins\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
  </ItemGroup>

</Project>

