<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MacDock</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacDock.Core\MacDock.Core.csproj" />
    <EmbeddedResource Include="Effects\MetalRim\MetalRim.hlsl" LogicalName="MacDock.MetalRim.hlsl" />
    <EmbeddedResource Include="Effects\ActiveIcon\ActiveIcon.hlsl" LogicalName="MacDock.ActiveIcon.hlsl" />
    <EmbeddedResource Include="Effects\ActiveIcon\ClickGlass.hlsl" LogicalName="MacDock.ClickGlass.hlsl" />
    <EmbeddedResource Include="Effects\Glass\DropLens.hlsl" LogicalName="MacDock.DropLens.hlsl" />
  </ItemGroup>

</Project>
