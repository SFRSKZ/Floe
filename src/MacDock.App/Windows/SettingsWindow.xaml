<Window x:Class="MacDock.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacDock Ayarları"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ModeToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="#14FFFFFF"
                                BorderBrush="#24FFFFFF"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="14,7"
                                Margin="0,0,8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D5BC8FF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8A5BC8FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="#14FFFFFF"
                                BorderBrush="#24FFFFFF"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F20E1014"
            BorderBrush="#2EFFFFFF"
            BorderThickness="1"
            CornerRadius="14"
            Padding="18">
        <StackPanel Width="330">
            <TextBlock Text="Aura"
                       Foreground="#F2FFFFFF"
                       FontSize="15"
                       FontWeight="SemiBold" />
            <TextBlock Text="Aktif ikonun çevresindeki renkler"
                       Foreground="#8AFFFFFF"
                       FontSize="11.5"
                       Margin="0,2,0,14" />

            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ModePalette" Style="{StaticResource ModeToggle}" Content="Palet" />
                <RadioButton x:Name="ModeIcon" Style="{StaticResource ModeToggle}" Content="İkon renkleri" />
            </StackPanel>

            <TextBlock x:Name="PaletteHeader"
                       Text="Palet seç"
                       Foreground="#8AFFFFFF"
                       FontSize="11.5"
                       Margin="2,16,0,8" />
            <StackPanel x:Name="PaletteList" />

            <Button x:Name="CloseButton"
                    Style="{StaticResource GlassButton}"
                    Content="Kapat"
                    Margin="0,18,0,0"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Border>
</Window>
