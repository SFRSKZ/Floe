<Window x:Class="MacDock.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacDock Ayarları"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ModeToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="#14FFFFFF"
                                BorderBrush="#24FFFFFF"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="14,7"
                                Margin="0,0,8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D5BC8FF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8A5BC8FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassSlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="#24FFFFFF" />
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#F2FFFFFF" Stroke="#5BC8FF" StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd"
                                Background="#14FFFFFF"
                                BorderBrush="#24FFFFFF"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="14,7">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot"
                                         Width="8"
                                         Height="8"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Fill="#4DFFFFFF" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D5BC8FF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8A5BC8FF" />
                                <Setter TargetName="Dot" Property="Fill" Value="#5BC8FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="#14FFFFFF"
                                BorderBrush="#24FFFFFF"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F20E1014"
            BorderBrush="#2EFFFFFF"
            BorderThickness="1"
            CornerRadius="14"
            Padding="18">
        <StackPanel Width="330">
            <TextBlock Text="İkon efekti"
                       Foreground="#F2FFFFFF"
                       FontSize="15"
                       FontWeight="SemiBold" />
            <TextBlock Text="Aktif ikonun çevresindeki parlama"
                       Foreground="#8AFFFFFF"
                       FontSize="11.5"
                       Margin="0,2,0,12" />

            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="EffectGlow" Style="{StaticResource ModeToggle}" Content="Işıltı" />
                <RadioButton x:Name="EffectBurst" Style="{StaticResource ModeToggle}" Content="Hayalet" />
            </StackPanel>

            <StackPanel x:Name="IntensityPanel" Margin="0,14,0,0">
                <TextBlock Text="Hayalet yoğunluğu" Foreground="#8AFFFFFF" FontSize="11.5" Margin="2,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="IntensitySlider"
                            Style="{StaticResource GlassSlider}"
                            Minimum="0.5"
                            Maximum="2.5"
                            SmallChange="0.1"
                            LargeChange="0.25"
                            Value="1.5" />
                    <TextBlock x:Name="IntensityValue"
                               Grid.Column="1"
                               Width="36"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="#F2FFFFFF"
                               FontSize="12" />
                </Grid>
            </StackPanel>

            <Rectangle Height="1" Fill="#1EFFFFFF" Margin="0,16,0,14" />

            <TextBlock Text="Renkler"
                       Foreground="#F2FFFFFF"
                       FontSize="15"
                       FontWeight="SemiBold" />
            <TextBlock Text="Efektin kullandığı renkler"
                       Foreground="#8AFFFFFF"
                       FontSize="11.5"
                       Margin="0,2,0,12" />

            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ModePalette" Style="{StaticResource ModeToggle}" Content="Palet" />
                <RadioButton x:Name="ModeIcon" Style="{StaticResource ModeToggle}" Content="İkon renkleri" />
            </StackPanel>

            <TextBlock x:Name="PaletteHeader"
                       Text="Palet seç"
                       Foreground="#8AFFFFFF"
                       FontSize="11.5"
                       Margin="2,16,0,8" />
            <StackPanel x:Name="PaletteList" />

            <Rectangle Height="1" Fill="#1EFFFFFF" Margin="0,16,0,14" />

            <TextBlock Text="Masaüstü düğmesi"
                       Foreground="#F2FFFFFF"
                       FontSize="15"
                       FontWeight="SemiBold" />
            <TextBlock Text="Dock'un sağındaki hayalet düğme"
                       Foreground="#8AFFFFFF"
                       FontSize="11.5"
                       Margin="0,2,0,12" />

            <TextBlock Text="Stil" Foreground="#8AFFFFFF" FontSize="11.5" Margin="2,0,0,6" />
            <WrapPanel Margin="0,0,0,10">
                <RadioButton x:Name="StyleRing" Style="{StaticResource ModeToggle}" Content="Halka" />
                <RadioButton x:Name="StyleWindows" Style="{StaticResource ModeToggle}" Content="Pencereler" />
                <RadioButton x:Name="StyleMonitor" Style="{StaticResource ModeToggle}" Content="Monitör" />
                <RadioButton x:Name="StyleOrb" Style="{StaticResource ModeToggle}" Content="Küre" />
            </WrapPanel>

            <TextBlock Text="Boyut" Foreground="#8AFFFFFF" FontSize="11.5" Margin="2,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="SizeSlider" Style="{StaticResource GlassSlider}" Minimum="0.4" Maximum="1.6" SmallChange="0.05" LargeChange="0.1" Value="0.72" />
                <TextBlock x:Name="SizeValue" Grid.Column="1" Width="36" TextAlignment="Right" VerticalAlignment="Center" Foreground="#F2FFFFFF" FontSize="12" />
            </Grid>

            <TextBlock Text="Parlaklık" Foreground="#8AFFFFFF" FontSize="11.5" Margin="2,10,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="BrightSlider" Style="{StaticResource GlassSlider}" Minimum="0.3" Maximum="2.2" SmallChange="0.1" LargeChange="0.25" Value="1.0" />
                <TextBlock x:Name="BrightValue" Grid.Column="1" Width="36" TextAlignment="Right" VerticalAlignment="Center" Foreground="#F2FFFFFF" FontSize="12" />
            </Grid>

            <TextBlock Text="Renk" Foreground="#8AFFFFFF" FontSize="11.5" Margin="2,10,0,6" />
            <StackPanel x:Name="ButtonColors" Orientation="Horizontal" />

            <Rectangle Height="1" Fill="#1EFFFFFF" Margin="0,16,0,14" />

            <TextBlock Text="Cam"
                       Foreground="#F2FFFFFF"
                       FontSize="15"
                       FontWeight="SemiBold" />
            <TextBlock Text="Dock camının kenarı ve müzik efektleri"
                       Foreground="#8AFFFFFF"
                       FontSize="11.5"
                       Margin="0,2,0,12" />

            <TextBlock Text="Kenar stili" Foreground="#8AFFFFFF" FontSize="11.5" Margin="2,0,0,6" />
            <WrapPanel>
                <RadioButton x:Name="RimPlain" Style="{StaticResource ModeToggle}" Content="Sade" />
                <RadioButton x:Name="RimSilver" Style="{StaticResource ModeToggle}" Content="Gümüş" />
                <RadioButton x:Name="RimGold" Style="{StaticResource ModeToggle}" Content="Altın" />
                <RadioButton x:Name="RimChromatic" Style="{StaticResource ModeToggle}" Content="Renkli" />
            </WrapPanel>

            <TextBlock Text="İkon çıkıntısı" Foreground="#8AFFFFFF" FontSize="11.5" Margin="2,14,0,6" />
            <WrapPanel>
                <RadioButton x:Name="BulgeSoft" Style="{StaticResource ModeToggle}" Content="Yumuşak" />
                <RadioButton x:Name="BulgePedestal" Style="{StaticResource ModeToggle}" Content="Kaide" />
                <RadioButton x:Name="BulgeFlat" Style="{StaticResource ModeToggle}" Content="Düz" />
            </WrapPanel>

            <CheckBox x:Name="VisualizerToggle"
                      Style="{StaticResource GlassToggle}"
                      Content="Müzik görselleştirici"
                      Margin="0,10,0,0" />

            <TextBlock Text="Görselleştirici stili" Foreground="#8AFFFFFF" FontSize="11.5" Margin="2,14,0,6" />
            <WrapPanel>
                <RadioButton x:Name="VisualizerLookGlow" Style="{StaticResource ModeToggle}" Content="Işıltı" />
                <RadioButton x:Name="VisualizerLookHologram" Style="{StaticResource ModeToggle}" Content="Hologram" />
            </WrapPanel>

            <Button x:Name="CloseButton"
                    Style="{StaticResource GlassButton}"
                    Content="Kapat"
                    Margin="0,18,0,0"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Border>
</Window>
