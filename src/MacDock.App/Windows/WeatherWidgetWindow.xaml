<Window x:Class="MacDock.App.Windows.WeatherWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacDockWeather"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="Width"
        Height="68"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Grid x:Name="Root" RenderTransformOrigin="0.5,1.0">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" />
        </Grid.RenderTransform>

        <Rectangle x:Name="Backdrop" Stretch="Fill" IsHitTestVisible="False">
            <Rectangle.Fill>
                <ImageBrush x:Name="BackdropBrush" Stretch="Fill" />
            </Rectangle.Fill>
        </Rectangle>

        <Border CornerRadius="16" BorderThickness="1" Padding="14,6" Margin="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#3DFFFFFF" Offset="0" />
                    <GradientStop Color="#1AFFFFFF" Offset="0.08" />
                    <GradientStop Color="#1C1A1C24" Offset="0.42" />
                    <GradientStop Color="#420A0C14" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#4DFFFFFF" Offset="0" />
                    <GradientStop Color="#1FFFFFFF" Offset="0.5" />
                    <GradientStop Color="#26FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="46" Height="46">
                    <Image x:Name="WeatherIconImage" Stretch="Uniform" Visibility="Collapsed" />
                    <TextBlock x:Name="WeatherIcon" Text="🌡" FontSize="30"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Margin="10,0,2,0" VerticalAlignment="Center">
                    <TextBlock x:Name="WeatherTemp" Text="--°" FontSize="24" FontWeight="Bold" Foreground="White" />
                    <TextBlock x:Name="WeatherLocation" Text="Night City" Foreground="#B0FFFFFF" FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
